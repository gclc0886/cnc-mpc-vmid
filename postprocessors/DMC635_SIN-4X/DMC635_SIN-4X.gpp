;                 ;DMC635_SIN
;                Sennik53 09.03.2016
;                Modified for 4-axis wrapping: 2026-01-09
@init_post
  global numeric flag1 flag2
  global string tool_diameter_f  spin_f cCb cCe cPb sCamfilepath
  global logical rapid_flag bUseprogname bUseprognum bStartFile bTlist bTlchg bTlseperation
  global numeric drill_lower_zz drill_upper_zz drill_clearance_zz
  global numeric safety_plane_zz
  global numeric save_spin_unit  m_feed_flag op_number sav_xpos sav_ypos
  global string f_name  GCODE_NAME
  GLOBAL INTEGER open_file_count  pre_part_home_number no_rapid_flag home_flag
  global logical main_program bOptstpbegin
  global numeric xold yold zold cold
  global string bez
  global integer iSlength_g_file_name iSlength_full_g_file_name iSlengthcampartpath iStopmode
  global integer iDrillmode
  
  ; 4-Axis Transformation Variables
  global numeric global_a_pos global_a_prev fourth_axis
  global numeric y_calc z_calc
  global numeric y_wrap   ; For wrapping: Y always = 0
  global numeric wrap_delta_a  ; Delta angle from SolidCAM (dapos)

  ; Non GPPL variables
  num_user_procs =    1
  line_labels    = FALSE     ; Jump to N...

  ; GPPL variables
  pre_processor   ='DMC635_SIN'
  numeric_def_f   = '5.3(p)'
  integer_def_f   = '5.0(p)'
  gcode_f         = '2.0(p)'
  mcode_f         = '2.0(p)'
  xpos_f          = '5.3(p)'
  ypos_f          = '5.3(p)'
  zpos_f          = '5.3(p)'
  apos_f          = '5.3(p)'
  feed_f          = '4.0(p)'
  tool_diameter_f = '5.3/1'
  blknum_f        = '5.0(p)'
  blknum_gen      = true
  blknum_exist    = true
  blknum          =    10
  blknum_delta    =    10
  blknum_max      = 999999
  call @usr_ip_useroptions
     trace 'all':0
     
     ; Initialize 4-axis variables
     global_a_pos = 0
     global_a_prev = 0
     y_wrap = 0
endp
;------------------------------------
@usr_ip_useroptions
  bTlseperation				= false         ;True =Список инстр-тов пустой строкой(строками)
  bTlist					= true          ;True = вывод списка инстр-та в начале прог-мы
  cPb                             = '%_N_'        ;Установка Символа(ов) при использовании  начала файла (i.e %)
  cCb                            = ';'                 ;Установка начального(ных) Символа(ов) для комментариев
  cCe                             = ''                  ;Установка конечного(ных) Символа(ов) для комментариев
  bUseprogname          = TRUE           ;True = Выполняется  вывод  имени программы
endp
;-------------------
@start_of_file
  ; Начало файла
  ; Это - первая процедура (ложь...@init_post действительно первая)
  call @usr_campart_path
  ;  call @usr_init_gmstates
  call @usr_sof_character
  call @usr_sof_progname
  ;   call @usr_sof_commentsbeforecodes
  ;   call @usr_sof_gmcodes
  ;   call @usr_sof_commentsaftercodes
  bStartFile = true
endp

;--------------------------------------------------------


@usr_sof_progname

  ; Номер программы и/или имя
  Local Integer name1 name2
  Local string part_name1 part_name2
  name1 = strlen(part_name)
  name2 = instr(part_name,'-')
  while name2 gt 0
    name2 = instr(part_name,'-')
    if name2 gt 0
      part_name = left(part_name,(name2-1)) + '_' + right(part_name,(name1-name2))
    endif
  endw
  if bUseprognum
    {nl, 'O'(program_number)}
    if bUseprogname
      {nl,cCb, part_name,cCe}
    endif
  else

    if bUseprogname
      {part_name'_MPF' }
    endif
  endif
  {nl,';$PATH=/_N_WKS_DIR/_N_123123_WPD'}
  if bez ne ''
    {nl,  ';*'  bez'*'}
  else
    {nl,';*'g_file_name,'*'}
  endif
endp

;--------------------------------------------------------
@usr_sof_character
  ; Начальный стартовый символ файла
  {,cPb}
endp

;--------------------------------------------------------

@usr_campart_path
  ; Использование Функции Строки, чтобы получать Путь к Папке   (CAM-Part)
  iSlength_g_file_name = strlen( g_file_name)
  iSlength_full_g_file_name = strlen(full_g_file_name)
  iSlengthcampartpath = iSlength_full_g_file_name - iSlength_g_file_name
  sCamfilepath = left(full_g_file_name,iSlengthcampartpath)
endp

;--------------------------------------------------------
@rotary_info
  ; Get cylinder info from SolidCAM for wrapping operations
  ; Called automatically when rot_axis_type is axis4_radial
  if rot_axis_type eq axis4_radial then
    {nb, ';Wrapping: Cylinder diameter = ', radial_diameter, ' mm'}
  endif
endp

;--------------------------------------------------------
@def_tool
  ; Вывод списка инструмента в начале программы
  ; Использование bTlchg, для определения сообщения при смене инструмента
  if bTlist
    if tool_message == '' then
      {nl, cCb'TOOL 'tool_number, ' - DIA '(tool_offset*2),cCe }
    else
      {nl,cCb'T'tool_number,'-' tool_message,cCe}
      if msg_mill_tool1 ne ''
        {nl,cCb'---' msg_mill_tool1,cCe}
      endif
      if msg_mill_tool2 ne ''
        {nl,cCb'---' msg_mill_tool2,cCe}
      endif
      if msg_mill_tool3 ne ''
        {nl,cCb'---' msg_mill_tool3,cCe}
      endif
      if msg_mill_tool4 ne ''
        {nl,cCb'---' msg_mill_tool4,cCe}
      endif
      if msg_mill_tool5 ne ''
        {nl,cCb'---' msg_mill_tool5,cCe}
      endif
    endif
    if next_command ne '@def_tool' and bTlchg eq false
      if bTlseperation
        {nl}
        {nl}
        {nl}
      endif
      if bOptstpbegin
        call @usr_optionalstop
      endif
    endif
  endif
endp

;--------------------------------------------------------

@start_program
endp

;-------------------
@usr_optionalstop
  ; Вывод опционального останова (G/M код)
  iStopmode = 1
  {nb, 'M'iStopmode:mcode_f' '}
endp

;--------------------------------------------------------

@usr_optionalstop1
  ; Вывод пционального останова (G/M код)
  ;Ноль для этого станка (DMC100)
  iStopmode =0
  {nb, 'M'iStopmode:mcode_f' '}
endp

;--------------------------------------------------------

@end_program
  ;Конец программы
  {nb, 'M9'}
  {nb,'G0'[' Z'ztool] ' M5'}
  {nb,'G0',' X'xtool,' Y'ytool}
  {nb, 'M2'}
  main_program    = false
endp

;-------------------

@end_of_file
  ;Конец файла
  {nl, 'M30'}
  {nl}
  {nl}
  {nl}
  {nl,'%'}
endp

;-------------------

@relative_mode
  ;Относительная система отсчета
  gcode = 91
  {nb, 'G'gcode,' '}
  skipline = FALSE
endp

;-------------------

@absolute_mode
  ;Абсолютная система отсчета
  gcode = 90
  {nb, 'G'gcode, ' '}
  skipline = FALSE
endp

;-------------------

@machine_plane
  ;Определение рабочей плоскости
  if machine_plane eq XY
    gcode = 17
  endif
  if machine_plane eq YZ
    gcode = 18
  endif
  if machine_plane eq ZX
    gcode = 19
  endif
  {nb, 'G'gcode}
endp

;-------------------

@call_proc
endp

;-------------------

@proc
  ;Подпрограмма
  {nl, 'L'label}
endp

;-------------------

@end_proc
  ;конец подрограммы
  {nb, 'M17'}
endp

;----------------

@loop
endp

;----------------

@end_loop
endp

;----------------

@rapid_move
  ; Rapid move with 4-axis calc
  call @calc_clean_4axis
  {nb}
  gcode = 0
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_calc]}
  {[' Z'z_calc]}
  ; Output A only for WRAPPING (continuous 4-axis)
  ; For INDEX machining, A is set once per face in @start_of_job
  if rot_axis_type eq axis4_radial then
    if change(global_a_pos)
      {' A'global_a_pos}
    endif
  endif
endp

;-------------------

@move_4x
  ; 4-Axis Rapid Move (for indexing operations)
  fourth_axis = cpos
  call @calc_clean_4axis

  {nb}
  gcode = 0
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_calc]}
  {[' Z'z_calc]}
  if change(global_a_pos)
     {' A'global_a_pos}
  endif
endp

@line_4x
  ; 4-Axis Linear Move (for indexing operations)
  fourth_axis = cpos
  call @calc_clean_4axis

  {nb}
  gcode = 1
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_calc]}
  {[' Z'z_calc]}
  if change(global_a_pos)
     {' A'global_a_pos}
  endif
  {[' F'feed]}
endp

;-----------------------------------------------------
; 4-AXIS WRAPPING PROCEDURES (continuous rotation)
; Y is replaced by A rotation, Z is radial distance
;-----------------------------------------------------

@move_5x
  ; Wrapping rapid move
  ; Y = 0 (always), Z = radial distance, A = rotation angle
  
  ; Pass delta angle from SolidCAM for accurate accumulation
  fourth_axis = apos
  wrap_delta_a = dapos
  call @calc_wrap_angle
  
  ; Y is always 0 for wrapping (output only when changed)
  y_wrap = 0
  
  {nb}
  gcode = 0
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_wrap]}
  {[' Z'zpos]}
  if change(global_a_pos)
     {' A'global_a_pos}
  endif
endp

@line_5x
  ; Wrapping linear move
  ; Y = 0 (always), Z = radial distance, A = rotation angle
  
  ; Pass delta angle from SolidCAM for accurate accumulation
  fourth_axis = apos
  wrap_delta_a = dapos
  call @calc_wrap_angle
  
  ; Y is always 0 for wrapping (output only when changed)
  y_wrap = 0
  
  {nb}
  gcode = 1
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_wrap]}
  {[' Z'zpos]}
  if change(global_a_pos)
     {' A'global_a_pos}
  endif
  {[' F'feed]}
endp

;-----------------------------------------------------
; Angle calculation for wrapping (continuous unwrap)
; Uses dapos from SolidCAM for accurate delta angle
;-----------------------------------------------------
@calc_wrap_angle
  ; Use delta angle directly from SolidCAM (wrap_delta_a = dapos)
  ; This handles spiral cuts correctly (delta > 180°)
  
  ; Accumulate angle using SolidCAM's precise delta
  global_a_pos = global_a_pos + wrap_delta_a
  
  ; Keep angle positive (machine range: 0 to 3600°)
  while global_a_pos < 0
      global_a_pos = global_a_pos + 360
  endw
  
  ; Warning if approaching machine limit
  if global_a_pos > 3500
      {nb, ';WARNING: A-axis approaching limit (', global_a_pos, '°)'}
  endif
  
  ; Update tracker for reference
  global_a_prev = fourth_axis
endp

;-----------------------------------------------------


@line
  ; Linear move with 4-axis calc
  call @calc_clean_4axis
  {nb}
  gcode = 1
  {'G'gcode}
  {[' X'xpos]}
  {[' Y'y_calc]}
  {[' Z'z_calc]}
  ; Output A only for WRAPPING (continuous 4-axis)
  if rot_axis_type eq axis4_radial then
    if change(global_a_pos)
      {' A'global_a_pos}
    endif
  endif
  {[' F'feed]}
endp


;-------------------

@arc
  ;Движение по окружности
  {nb}
  if change(arc_plane) then
    if arc_plane eq XY then
      gcode = 17
    endif
    if arc_plane eq YZ then
      gcode = 18
    endif
    if arc_plane eq ZX then
      gcode = 19
    endif
    {'G'gcode, ' '}
  endif

  if arc_direction eq CCW then
    gcode = 3
  else         ; CW
    gcode = 2
  endif
  if change(gcode) then
    {'G'gcode}
  else
    {'  '}
  endif
  if job_type eq 'thread'
    if arc_plane eq XY
      {' X'xpos ,' Y'ypos}
      {' I'xcenter_rel:xpos_f, ' J'ycenter_rel:ypos_f}
      {[' Z'zpos]}
    endif
  else
    {[' X'xpos] ,[' Y'ypos], [' Z'zpos]}
    if arc_size >180 then
      radius = -radius
    endif
    {' CR='radius}
  endif
  if m_feed_flag eq 1
    m_feed_flag = 0
    { ' F'feed}
  else
    { [' F'feed]}
  endif
endp

;-------------------

@compensation
  ;Компенсация инструмента
  if side eq COMP_LEFT then
    gcode = 41
  endif
  if side eq COMP_RIGHT then
    gcode = 42
  endif
  if side eq COMP_OFF then
    gcode = 40
  endif
  {nb, 'G'gcode}
  skipline = FALSE
endp

;-------------------

@delay
  ;Выдержка времени
  gcode = 4
  {nb 'G'gcode, 'P'delay_period:integer_def_f}
endp

;-------------------

@change_ref_point
endp

;-------------------

@home_number
  ;НАЧАЛО КООРДИНАТ ПРОГРАММЫ
  gcode = 53 + home_number
  {nb, 'G'gcode}
  flag2 = 1
endp

;-------------------

@rotate
  ; Indexial milling rotation (3+2)
  if rotate_cancel then
    ; Cancel rotation - no output needed
  else
    ; Safe Z retract before rotation
    {nb, 'G0 Z'ztool}
    
    ; Rotate to new angle
    fourth_axis = 180 - rotate_angle_x
    call @calc_clean_4axis
    {nb, 'G0 A'global_a_pos}
  endif
endp

;-------------------

@fourth_axis
  ; For INDEX machining: DO NOT output here
  ; Rotation is handled in @start_of_job with safe Z retract
  ; This procedure is called between faces but outputs nonsense like A-0, A-360
  
  ; Only output for wrapping operations
  if rot_axis_type eq axis4_radial then
    gcode = 0
    {nb, 'G'gcode, ' A'(angle + rotate_angle_x)}
  endif
endp

;-------------------

@fourth_axis_move
  ; For INDEX machining: rotation handled in @start_of_job
  if rot_axis_type eq axis4_radial then
    gcode = 0
    {nb, 'G'gcode, ' A'rotate_angle_x}
  endif
endp

;-------------------

@change_tool
  ;Смена инструмента
  local logical save_blknum_gen
  if !first_tool
    {nb, 'M9'}
    {nb, ['G0 Z'ztool]' M5'}
    {nb,'G0 X'xtool, ' Y'ytool}
    {nb,'M1'}
    op_number = op_number + 1
  endif
  
  if tool_message == '' then
    {nb, ';*T'tool_number, '_DIAMETR_'tool_diameter, '*'}
  else
    {nb,';*DIAMETR_' tool_diameter,'*'}
  endif
  {nb, 'T="INSTRUMENT_'tool_number,'"'}
  {nb,'M6'}
  tool_direction = CW
  call @start_tool
  
  {nb, 'G90 G0 '}
  {nb, 'M8 '}
  
  ; DIRECT OUTPUT: Initial safe positioning without 4-axis transformation
  ; This ensures tool starts at safe height (ztool) matching end position (N180)
  ; Bypasses @rapid_move to avoid unwanted yhpos/zhpos transformation
  {nb, 'G0 X'xtool, ' Y'ytool, ' Z'ztool}
  ; Y is not pre-positioned here: ynext is in the face CoordSys and would have
  ; the wrong sign for indexing. The first move outputs the mapped Y instead;
  ; force it, because the machine is now at ytool, not at the last tracked Y.
  {nb, 'G0 X'xnext, ' Z'ztool}
  change(y_calc) = true

  skipline = TRUE
  no_rapid_flag = true
endp

;-------------------

@message
endp

;-------------------

@drill
  ;Сверление (циклы) - SIEMENS CYCLE83 FULLY CORRECTED VERSION
  local numeric rtp rfp sdis dp
  local numeric drilling_start_surface
  
  drilling_start_surface = drill_upper_z
  rtp  = drill_clearance_z
  rfp  = drilling_start_surface
  sdis = safety
  dp   = drill_lower_z
  
  if rfp <= dp then
    {nb, ';*** FATAL ERROR: RFP (', rfp, ') <= DP (', dp, ') ***'}
    {nb, ';*** Drilling start surface at or below final depth - Check CAM geometry ***'}
    return
  endif
  
  if rtp < rfp then
    {nb, ';*** WARNING: RTP (', rtp, ') < RFP (', rfp, ') - Auto-adjusting ***'}
    rtp = rfp + 2.0
  endif
  
  if rfp < -0.1 then
    {nb, ';INFO: Drilling below Z0 - RFP=', rfp, ' (OK for stepped parts)'}
  endif

  call @rapid_move
  
  if drill_type eq G81 then
    gcode = 81
  endif
  if drill_type eq G82 then
    gcode = 82
  endif
  if drill_type eq G83 then
    gcode = 83
  endif
  if drill_type eq G84 then
    gcode = 84
  endif
  if drill_type eq G86 then
    gcode = 86
  endif
  
  {nb,' F'feed }
  {nb,'MCALL CYCLE',gcode}

  if drill_type eq G81 then 
    {' (',rtp,',',rfp,',',sdis,',',dp,')'}
    {nb,';  RTP=',rtp,' RFP=',rfp,' (true start surface, ABS WCS) DP=',dp}
  endif

  if drill_type eq G82 then 
    {' (',rtp,',',rfp,',',sdis,',',dp,',,',delay,')'}
    {nb,';  RTP=',rtp,' RFP=',rfp,' (true start surface, ABS WCS) DP=',dp,' DELAY=',delay}
  endif

  if drill_type eq G83 then
    {' (',rtp,',',dp,',',rfp,',',feed,',,',down_step,',,',down_step,',,,1,1)'}
    {nb,';  RTP=',rtp,' DP=',dp,' RFP=',rfp,' FEED=',feed,' STEP=',down_step}
  endif

  if drill_type eq G84 then
     {' (',rtp,',',rfp,',',sdis,',',dp,',,,3,,,', (feed/spin), ')'}
     {nb,';  RTP=',rtp,' RFP=',rfp,' (true start surface, ABS WCS) DP=',dp,' PITCH=',(feed/spin)}
  endif

  if drill_type eq G86 then
     {' (',rtp,',',rfp,',',sdis,',',dp,',,,3)'}
     {nb,';  RTP=',rtp,' RFP=',rfp,' (true start surface, ABS WCS) DP=',dp}
  endif
endp

;--------------------------------------------------------

@drill4x_pnt
  ; 4-Axis Drilling Point (for Trajectory Transform)
  fourth_axis = cpos
  call @calc_clean_4axis
  call @rapid_move
endp

@drill_point
  ; Точки сверления
  {nb,['X'xpos ' '], ['Y'ypos ' '], ['Z'zpos ' ']}
endp

;--------------------------------------------------------

@end_drill
  ; Вывод отмены  циклов сверления
  iDrillmode = 80
  if change(iDrillmode)
    {nb, 'MCALL '}
    iDrillmode = 9999
  endif
  if drill_type eq G84
    {nb, 'G94'}
  endif
endp

;--------------------------------------------------------

@halt_program
  ;Стоп программы
  {' M0'}
endp

;--------------------

@round_comp
endp

;--------------------

@start_of_job
  ; Handle positioning at start of job
  
  if rot_axis_type eq axis4_radial then
    ; WRAPPING: Do NOT initialize global_a_pos here
    ; First @move_5x/@line_5x will use dapos to set correct angle
    ; global_a_pos starts at 0 (from @init_post), dapos gives correct delta
    
    ; Reset y_wrap to force Y0 output in first move
    y_wrap = -1
  else
    ; INDEXING (3+2): Safe Z retract BEFORE rotation
    if change(first_axis_angle) then
      ; 1. Retract to safe Z height before rotating
      {nb, 'G0 Z'ztool}
      
      ; 2. Rotate A-axis to new face
      fourth_axis = 180 - first_axis_angle
      call @calc_clean_4axis
      {nb, 'G0 A'global_a_pos}
    endif
  endif
endp

;--------------------

@end_of_job
endp

;--------------------

@assign_axis
endp

;     =======================
;     USER DEFINED PROCEDURES
;     =======================

@call_simple_proc
  active(message) = FALSE
  active(parm1)   = FALSE
  active(parm2)   = FALSE
  active(parm3)   = FALSE
  proc_count      = 1
  call @call_proc
endp

;-------------------

@start_tool
  ;Шпиндель
  if tool_direction eq CW then
    mcode = 3
  else
    mcode = 4
  endif
  {nb,'S'spin:integer_def_f, ' M'mcode}
endp

;-------------------

@m_feed_spin
endp

;-------------------

@stop_tool
endp

;--------------------------------------------------------
@calc_clean_4axis
  local numeric delta_a
  
  ; Continuous angle accumulation (unwrapping)
  delta_a = fourth_axis - global_a_prev
  
  ; Handle ±180° wraparound
  if delta_a > 180
      delta_a = delta_a - 360
  endif
  if delta_a < -180
      delta_a = delta_a + 360
  endif
  
  global_a_pos = global_a_pos + delta_a
  
  ; Keep angle positive (machine range: 0 to 3600°)
  while global_a_pos < 0
      global_a_pos = global_a_pos + 360
  endw
  
  ; Warning if approaching machine limit
  if global_a_pos > 3500
      {nb, ';WARNING: A-axis approaching limit (', global_a_pos, '°)'}
  endif
  
  ; Update angle tracker
  global_a_prev = fourth_axis
  
  ; ========================================================================
  ; COORDINATE SELECTION
  ; ========================================================================
  ; Indexed 4-axis: the face CoordSys has the tool on its -Z side, so rotate
  ; it 180 deg about X (Y->-Y, Z->-Z); A is mapped to 180-angle in
  ; @start_of_job/@rotate. Verified via ;DBG dump + VMID kinematics.
  if rot_axis_type eq axis4_radial then
    y_calc = yhpos
    z_calc = zhpos
  else
    ; 0 - v instead of -v: avoids printing "Y-0" when the value is zero
    y_calc = 0 - ypos
    z_calc = 0 - zpos
  endif
endp
